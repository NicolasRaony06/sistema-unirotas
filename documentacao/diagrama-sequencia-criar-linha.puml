@startuml
' =============================================================================
' Diagrama de Sequência — Caso de Uso: CRIAR LINHA (UniRota)
' Abrange também a criação de Rotas (Ida/Volta) e de Trechos.
'
' Notação baseada no material:
'   "Modelos - Diagrama de Sequencia.pptx.pdf" — Profa. Me. Beatriz Soares
'     (atores, linhas de vida, mensagem de criação, síncrona/retorno,
'      foco de controle, invariante de estado e fragmentos alt/opt/loop/break/critical)
'
' Implementação baseada em:
'   management/views.py::criar_linha, management/forms.py, management/models.py,
'   management/templates/manager/criar_linha.html, authentication/decorators.py
' =============================================================================

title Diagrama de Sequência — Criar Linha (com Rotas e Trechos) — UniRota

skinparam sequence {
  ArrowColor #355C7D
  ActorBorderColor #355C7D
  LifeLineBorderColor #7F9FB8
  ParticipantBackgroundColor #EAF3FA
  ParticipantBorderColor #355C7D
  GroupBackgroundColor #F2F7FB
  GroupBorderColor #7F9FB8
  NoteBackgroundColor #FFF6D5
  NoteBorderColor #D1A72C
}
skinparam fontSize 11
skinparam noteFontSize 10
autonumber "<b>[00]"

actor "Gestor\n(autenticado, role = MANAGER)" as Gestor
participant ":TelaCriarLinha\n(criar_linha.html)" as UI
participant ":criar_linha\n(Django view)" as View
participant ":LinhaForm" as LF
participant ":RotaForm (Ida)" as RFIda
participant ":RotaForm (Volta)" as RFVolta
participant ":Linha" as Linha
participant ":Rota (Ida)" as RotaIda
participant ":Rota (Volta)" as RotaVolta
participant ":TrechoViagem (Ida)" as TrechoIda
participant ":TrechoViagem (Volta)" as TrechoVolta
participant ":ORM / Banco" as DB

== Pré-condição: Gestor autenticado; município vinculado ao perfil ==

Gestor -> UI : acessa /management/criar-linha/ (GET)
activate UI
UI -> View : HttpRequest(GET)
activate View
View -> View : @login_required + @role_required(MANAGER)

break Interrompe: acesso negado (anônimo ou role ≠ MANAGER)
  View --> Gestor : 403 "Acesso negado." / redirect(login)
end break

View -> DB : busca municípios relacionados, motoristas, instituições, ônibus e paradas
activate DB
DB --> View : listas para os campos <select>
deactivate DB
View --> UI : render("manager/criar_linha.html", contexto)
deactivate View
UI --> Gestor : exibe formulário (Linha | Rota de Ida | Rota de Volta | Trechos)
deactivate UI

== Fluxo principal: submissão, validação e criação ==

Gestor -> UI : preenche Linha, Ida, (Volta) e Trechos; clica "Salvar linha"\n(POST: linha-*, Ida-*, Volta-*, trecho_*)
activate UI
UI -> View : HttpRequest(POST)
activate View
View -> View : revalida autenticação/perfil (decorators)

create LF
View -> LF : <<create>> linha_form = LinhaForm(request.POST, prefix="linha")
activate LF
create RFIda
View -> RFIda : <<create>> rota_form = RotaForm(request.POST, prefix="Ida")
activate RFIda
create RFVolta
View -> RFVolta : <<create>> rota_voltaform = RotaForm(request.POST, prefix="Volta")
activate RFVolta

View -> LF : is_valid()
LF --> View : linha_valida : True/False
View -> RFIda : is_valid()
RFIda --> View : ida_valida : True/False
View -> RFVolta : has_changed() / is_valid()
RFVolta --> View : volta_presente : True/False ; volta_valida

alt linha_valida ∧ ida_valida ∧ (¬volta_presente ∨ volta_valida)

  critical transaction.atomic() — criação atômica de Linha e Rotas

    create Linha
    View -> Linha : <<create>> linha = linha_form.save(commit=False)
    activate Linha
    View -> Linha : linha.city = request.user.personel_profile.city
    Linha -> DB : save() → full_clean() → INSERT Linha
    activate DB
    DB --> Linha : linha.pk
    deactivate DB
    View -> LF : save_m2m()
    LF -> DB : INSERT vínculos instituicoes_ofertadas
    activate DB
    DB --> LF : ok
    deactivate DB
    deactivate Linha
    note over Linha : {is_active = True; horario_fim > horario_inicio}

    create RotaIda
    View -> RotaIda : <<create>> Ida = rota_form.save(commit=False)
    activate RotaIda
    View -> RotaIda : Ida.linha = linha
    RotaIda -> DB : save() → INSERT Rota (IDA)
    activate DB
    DB --> RotaIda : pk
    deactivate DB
    deactivate RotaIda
    note over RotaIda : {única por (linha, direção = IDA)}

    opt <<include>> Criar Rota (Volta) — volta_presente
      create RotaVolta
      View -> RotaVolta : <<create>> Volta = rota_voltaform.save(commit=False)
      activate RotaVolta
      View -> RotaVolta : Volta.linha = linha
      RotaVolta -> DB : save() → INSERT Rota (VOLTA)
      activate DB
      DB --> RotaVolta : pk
      deactivate DB
      deactivate RotaVolta
      note over RotaVolta : {única por (linha, direção = VOLTA)}
    end opt

  end critical

  View -> View : lê trecho_ordem[], trecho_parada_inicio[],\ntrecho_parada_fim[], trecho_distancia_km[]

  loop <<include>> Criar Trecho — para cada (ordem, início, fim, distância)
    create TrechoIda
    View -> TrechoIda : <<create>> TrechoViagem.objects.create(rota=Ida, ...)
    activate TrechoIda
    TrechoIda -> DB : INSERT Trecho (IDA)
    activate DB
    DB --> TrechoIda : pk
    deactivate DB
    deactivate TrechoIda
    note over TrechoIda : {ordem ≥ 1; distancia_km > 0; início ≠ fim}

    opt <<include>> Criar Trecho (Volta) — espelho do trecho de ida
      RotaVolta -> DB : UPDATE trechos existentes da Volta: ordem += 1
      activate DB
      DB --> RotaVolta : ok
      deactivate DB
      create TrechoVolta
      View -> TrechoVolta : <<create>> cópia do Trecho (IDA) com rota = Volta
      activate TrechoVolta
      View -> TrechoVolta : inverter() → troca início/fim; ordem = 1
      TrechoVolta -> DB : INSERT Trecho (VOLTA invertido)
      activate DB
      DB --> TrechoVolta : pk
      deactivate DB
      deactivate TrechoVolta
    end opt
  end loop

  View --> UI : redirect("management:linhas") [303]
  UI --> Gestor : lista de linhas com Linha + Rotas + Trechos criados

else Dados inválidos — fluxo alternativo
  View --> UI : render("manager/criar_linha.html", forms com errors)
  UI --> Gestor : reexibe o formulário com as mensagens de erro
end

deactivate View
deactivate UI

@enduml
